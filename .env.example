# ============================================================================
# PROMPTLY — Variables d'environnement
# ============================================================================
# Copier ce fichier en .env et remplir les valeurs

# ----------------------------------------------------------------------------
# SUPABASE (obligatoire)
# Obtenir sur : https://supabase.com/dashboard/project/_/settings/api
#
# La clé « publishable » (anon) est publique par conception : elle est servie au
# navigateur. Sa sécurité repose entièrement sur le Row Level Security activé
# côté Postgres — ne jamais mettre ici la clé « service_role ».
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ----------------------------------------------------------------------------
# OPENAI (obligatoire pour la génération IA)
# Obtenir sur : https://platform.openai.com/api-keys
#
# ⚠️  AVERTISSEMENT DE SÉCURITÉ
# Vite inline toute variable préfixée VITE_ dans le bundle client au moment du
# build. Cette clé est donc servie en clair à chaque visiteur du site déployé et
# reste extractible du JavaScript en quelques secondes.
#
# → Ne jamais renseigner une vraie clé pour un déploiement public.
# → Le correctif est de déplacer l'appel OpenAI dans server/, derrière un
#   endpoint appelé par le navigateur, et de lire la clé sans préfixe VITE_.
# ----------------------------------------------------------------------------
VITE_OPENAI_API_KEY=sk-proj-...
VITE_OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# BACKEND (optionnel — génération ZIP + déploiement)
# ----------------------------------------------------------------------------
VITE_SITEGEN_URL=http://localhost:4000
VITE_ORCHESTRATOR_URL=http://localhost:4001
