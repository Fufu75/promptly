# ============================================================================
# PROMPTLY — Variables d'environnement
# ============================================================================
# Copier ce fichier en .env et remplir les valeurs

# ----------------------------------------------------------------------------
# SUPABASE (obligatoire)
# Obtenir sur : https://supabase.com/dashboard/project/_/settings/api
#
# La clé « publishable » (anon) est publique par conception : elle est servie au
# navigateur. Sa sécurité repose entièrement sur le Row Level Security activé
# côté Postgres — ne jamais mettre ici la clé « service_role ».
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ----------------------------------------------------------------------------
# OPENAI — SERVEUR UNIQUEMENT (obligatoire pour la génération IA)
# Obtenir sur : https://platform.openai.com/api-keys
#
# Ces deux variables n'ont volontairement PAS de préfixe VITE_ : elles sont
# lues par server/index.js et ne doivent jamais atteindre le navigateur. Vite
# inline toute variable VITE_ dans le bundle client au moment du build, donc
# la renommer en VITE_OPENAI_API_KEY reviendrait à la publier.
#
# Le navigateur appelle POST {VITE_SITEGEN_URL}/ai/chat ; c'est le serveur qui
# détient la clé et relaie la requête à OpenAI.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# BACKEND — requis : porte le relais IA en plus de la génération de ZIP
# ----------------------------------------------------------------------------
VITE_SITEGEN_URL=http://localhost:4000
VITE_ORCHESTRATOR_URL=http://localhost:4001
